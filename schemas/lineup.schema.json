{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed weekly lineup",
  "type": "object",
  "required": ["schema_version", "rationale", "league_id", "roster_id", "season", "week", "created_at", "assignments"],
  "properties": {
    "schema_version": {"const": 2},
    "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "rationale_source": {"type": "string"},
    "lineup_id": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_lineup_id": {"type": ["string", "null"]},
    "league_id": {"type": "string", "minLength": 1},
    "roster_id": {"type": "integer"},
    "season": {"type": "integer"},
    "week": {"type": "integer", "minimum": 1, "maximum": 18},
    "created_at": {"type": "string", "format": "date-time"},
    "origin": {"type": "object"},
    "assignments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["slot_index", "slot", "player_id"],
        "properties": {
          "slot_index": {"type": "integer", "minimum": 0},
          "slot": {"type": "string"},
          "player_id": {"type": ["string", "null"]}
        }
      }
    }
  },
  "description": "Slot order, coverage, ownership, eligibility, availability and locks are validated against current provider evidence, not declarations in this file. Null represents an empty slot and fails lineup validation. Extra fields are metadata only."
}
