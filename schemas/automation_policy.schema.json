{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation policy version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "timezone", "lease_seconds", "allowed_operations"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["disabled", "observe", "propose"]},
    "timezone": {"type": "string", "minLength": 1, "description": "An installed IANA time zone. Runtime validation verifies this value."},
    "lease_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "allowed_operations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["collect_inputs", "inspect_sleeper", "propose_lineup", "validate_lineup", "integrated_review"]}
    }
  }
}
