{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deadline planning policy version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "timezone", "daily_time", "horizon_hours", "recovery_overlap_hours", "lateness_minutes", "execution_buffer_minutes", "task_cap", "reserved_slots", "retry_minutes", "source_max_age_seconds", "timing_max_age_seconds", "offsets_minutes", "allowed_operations"],
  "properties": {
    "schema_version": {"const": 1}, "timezone": {"type": "string"},
    "daily_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "horizon_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "recovery_overlap_hours": {"type": "integer", "minimum": 1, "maximum": 72},
    "lateness_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "execution_buffer_minutes": {"type": "integer", "minimum": 1, "maximum": 120},
    "task_cap": {"type": "integer", "minimum": 2, "maximum": 100},
    "reserved_slots": {"type": "integer", "minimum": 2, "maximum": 100},
    "retry_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "source_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "timing_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "offsets_minutes": {"type": "object", "additionalProperties": false, "required": ["game", "waiver", "review"],
      "properties": {"game": {"$ref": "#/$defs/offsets"}, "waiver": {"$ref": "#/$defs/offsets"}, "review": {"$ref": "#/$defs/offsets"}}},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["inspect_sleeper", "validate_lineup"]}}
  },
  "$defs": {"offsets": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
    "items": {"type": "integer", "minimum": 2, "maximum": 10080}}}
}
